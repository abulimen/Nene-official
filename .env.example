# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Frontend URL - The URL where your frontend application is hosted
# Local development: http://localhost:5173 (Vite default)
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# API Configuration - Backend API endpoint
# Local development: http://localhost:5000/api
# Production: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5000/api

# Admin URL - URL for the admin dashboard
# Local development: http://localhost:5173/admin
# Production: https://yourdomain.com/admin
ADMIN_URL=http://localhost:5173/admin

# Google OAuth Client ID for authentication
# Get from: https://console.cloud.google.com/
# Steps: Create project → Enable Google+ API → Create OAuth 2.0 credentials → Copy Client ID
VITE_GOOGLE_CLIENT_ID=

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

# Node environment
# Values: development, production, test
NODE_ENV=development

# Backend server port
# Default port for local development
PORT=5000

# JWT Secret Key - Used for signing JWT tokens
# Generate a secure random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# JWT Expiration time
# Format: Examples - "7d", "24h", "3600" (in seconds)
JWT_EXPIRES_IN=7d

# ============================================================================
# SUPABASE CONFIGURATION (Database & Auth)
# ============================================================================

# Supabase Project URL
# Get from: https://app.supabase.com/ → Your Project → Settings → API → Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (for backend server operations)
# Get from: https://app.supabase.com/ → Your Project → Settings → API → Service Role Key
# WARNING: Keep this secret! Only use on backend/server-side
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase Anon Key (for frontend/public operations)
# Get from: https://app.supabase.com/ → Your Project → Settings → API → Anon Key
# Safe to expose in frontend code
SUPABASE_ANON_KEY=your_anon_key_here

# ============================================================================
# EMAIL CONFIGURATION (Brevo/Sendinblue)
# ============================================================================

# Brevo API Key for sending emails
# Get from: https://app.brevo.com/ → Settings → API Keys → Create new key
BREVO_API_KEY=your_brevo_api_key_here

# Sender email address - The email address that sends emails
# Must be verified in Brevo: https://app.brevo.com/ → Senders & Contacts → Senders
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# Sender name - The name that appears as the sender
# Example: "Nene Yogurt"
BREVO_SENDER_NAME=Nene Yogurt

# ============================================================================
# PAYMENT GATEWAY (Paystack)
# ============================================================================

# Paystack Public Key - Used on frontend for payment initialization
# Get from: https://dashboard.paystack.com/ → Settings → API Keys & Webhooks → Public Key
# Safe to expose on frontend
PAYSTACK_PUBLIC_KEY=pk_live_your_public_key_here

# Paystack Secret Key - Used on backend for payment verification
# Get from: https://dashboard.paystack.com/ → Settings → API Keys & Webhooks → Secret Key
# WARNING: Keep this secret! Only use on backend/server-side
PAYSTACK_SECRET_KEY=sk_live_your_secret_key_here

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================

# Upload directory - Where to store uploaded files locally
# Default: ./uploads
UPLOAD_DIR=./uploads

# Maximum file size allowed for uploads
# Format: Size in bytes or with units (e.g., "10MB", "52428800" for 50MB)
MAX_FILE_SIZE=52428800

# Cloudinary URL for cloud-based image storage
# Get from: https://cloudinary.com/ → Dashboard → Environment Variable
# Format: cloudinary://api_key:api_secret@cloud_name
# Optional: Only needed if using Cloudinary instead of local uploads
