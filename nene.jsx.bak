// --- SVG Product Image Generator ---
const ProductImage = ({ type, className }) => {
    let color1, color2, label;
    if (type === 'Unsweetened Greek Yogurt') {
        color1 = "#0d9488"; color2 = "#115e59"; label = "Nené";
    } else if (type === 'Sweetened Greek Yogurt') {
        color1 = "#d97706"; color2 = "#92400e"; label = "Nené";
    } else {
        color1 = "#f5f5f4"; color2 = "#d6d3d1"; label = "Nené";
    }

    const isLight = type === 'Vanilla Ice Cream';

    return (
        <svg viewBox="0 0 200 200" className={className} xmlns="http://www.w3.org/2000/svg">
            <defs>
                <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
                    <feGaussianBlur in="SourceAlpha" stdDeviation="5" />
                    <feOffset dx="0" dy="5" result="offsetblur" />
                    <feComponentTransfer>
                        <feFuncA type="linear" slope="0.2" />
                    </feComponentTransfer>
                    <feMerge>
                        <feMergeNode in="offsetblur" />
                        <feMergeNode in="SourceGraphic" />
                    </feMerge>
                </filter>
            </defs>
            <g filter="url(#shadow)">
                {/* Lid */}
                <ellipse cx="100" cy="60" rx="70" ry="20" fill={color2} />
                <ellipse cx="100" cy="56" rx="68" ry="18" fill={color1} />

                {/* Body */}
                <path d="M35 60 Q 35 60 45 140 Q 50 170 100 170 Q 150 170 155 140 Q 165 60 165 60" fill={isLight ? '#ffffff' : '#1f2937'} />

                {/* Label Area */}
                <path d="M45 80 Q 45 80 50 130 Q 55 160 100 160 Q 145 160 150 130 Q 155 80 155 80" fill={color1} opacity="0.1" />

                {/* Branding */}
                <text x="100" y="115" fontFamily="sans-serif" fontWeight="bold" fontSize="28" fill={isLight ? '#1c1917' : '#ffffff'} textAnchor="middle" letterSpacing="-1">{label}</text>
                <text x="100" y="135" fontFamily="sans-serif" fontSize="8" fill={isLight ? '#44403c' : '#d1d5db'} textAnchor="middle" letterSpacing="2" textTransform="uppercase">{type.split(' ')[0]}</text>
            </g>
        </svg>
    );
};

// --- Helper Components ---

const SectionTitle = ({ children, subtitle }) => (
    <div className="text-center mb-12">
        <h2 className="text-3xl md:text-4xl font-bold text-stone-900 mb-3 font-serif">{children}</h2>
        {subtitle && <p className="text-stone-500 max-w-lg mx-auto">{subtitle}</p>}
    </div>
);

// --- Main Sections ---

// 1. Navbar
const Navbar = ({ cartCount, onOpenCart, activeTab, onNavigate }) => {
    const [scrolled, setScrolled] = useState(false);
    const [mobileMenuOpen, setMobileMenuOpen] = useState(false);

    useEffect(() => {
        const handleScroll = () => setScrolled(window.scrollY > 20);
        window.addEventListener('scroll', handleScroll);
        return () => window.removeEventListener('scroll', handleScroll);
    }, []);

    return (
        <>
            <nav className={`fixed w-full z-50 transition-all duration-300 ${scrolled ? 'bg-white/90 backdrop-blur-md shadow-sm py-4' : 'bg-transparent py-6'}`}>
                <div className="max-w-7xl mx-auto px-6 flex justify-between items-center">
                    <div
                        className="text-3xl font-bold tracking-tighter text-stone-900 cursor-pointer flex items-center gap-1"
                        onClick={() => onNavigate('home')}
                    >
                        Nené<span className="text-teal-600 text-4xl leading-3">.</span>
                    </div>

                    <div className="hidden md:flex items-center gap-8">
                        {['Home', 'Shop', 'Blog', 'Reviews', 'FAQ'].map((item) => (
                            <button
                                key={item}
                                onClick={() => onNavigate(item.toLowerCase())}
                                className={`text-sm font-medium uppercase tracking-widest transition-colors ${activeTab === item.toLowerCase() ? 'text-teal-600' : 'text-stone-500 hover:text-stone-900'
                                    }`}
                            >
                                {item}
                            </button>
                        ))}
                    </div>

                    <div className="flex items-center gap-6">
                        <button
                            onClick={onOpenCart}
                            className="relative text-stone-900 hover:text-teal-600 transition-colors"
                        >
                            <ShoppingBag size={24} />
                            {cartCount > 0 && (
                                <span className="absolute -top-2 -right-2 bg-teal-600 text-white text-[10px] font-bold w-5 h-5 flex items-center justify-center rounded-full">
                                    {cartCount}
                                </span>
                            )}
                        </button>
                        <button className="md:hidden text-stone-900" onClick={() => setMobileMenuOpen(true)}>
                            <Menu />
                        </button>
                    </div>
                </div>
            </nav>

            {/* Mobile Menu Sidebar (Offcanvas) */}
            <div
                className={`md:hidden fixed inset-0 bg-stone-900/40 backdrop-blur-sm z-[60] transition-opacity duration-300 ${mobileMenuOpen ? 'opacity-100 pointer-events-auto' : 'opacity-0 pointer-events-none'}`}
                onClick={() => setMobileMenuOpen(false)}
            />
            <div className={`md:hidden fixed top-0 left-0 h-full w-[300px] bg-white z-[70] transform transition-transform duration-300 shadow-2xl flex flex-col p-8 ${mobileMenuOpen ? 'translate-x-0' : '-translate-x-full'}`}>
                <div className="flex justify-between items-center mb-12">
                    <div className="text-2xl font-bold text-stone-900">Nené<span className="text-teal-600">.</span></div>
                    <button onClick={() => setMobileMenuOpen(false)} className="text-stone-400 hover:text-stone-900">
                        <X size={24} />
                    </button>
                </div>
                <div className="flex flex-col gap-6">
                    {['Home', 'Shop', 'Blog', 'Reviews', 'FAQ'].map((item) => (
                        <button
                            key={item}
                            onClick={() => {
                                onNavigate(item.toLowerCase());
                                setMobileMenuOpen(false);
                            }}
                            className={`text-left text-xl font-medium transition-colors ${activeTab === item.toLowerCase() ? 'text-teal-600 font-bold' : 'text-stone-600'
                                }`}
                        >
                            {item}
                        </button>
                    ))}
                </div>
                <div className="mt-auto pt-8 border-t border-stone-100 text-stone-500 text-sm">
                    <p>© 2025 Nené Dairy Co.</p>
                </div>
            </div>
        </>
    );
};

