                            <div className="text-center">
                                <p className="text-xs text-stone-500 uppercase tracking-widest">Calories</p>
                                <p className="font-bold text-stone-900">{product.nutrition.cal}</p>
                            </div>
                            <div className="text-center">
                                <p className="text-xs text-stone-500 uppercase tracking-widest">Protein</p>
                                <p className="font-bold text-stone-900">{product.nutrition.protein}</p>
                            </div>
                        </div>
                    </div>

                    <div className="space-y-8">
                        <div>
                            <h1 className="text-4xl md:text-5xl font-serif font-bold text-stone-900 mb-2">{product.name}</h1>
                            <div className="flex items-center gap-4 mb-4">
                                <span className="text-2xl font-medium text-teal-600">₦{product.price.toLocaleString()}</span>
                                <div className="flex items-center gap-1 text-amber-400 text-sm">
                                    <Star size={16} fill="currentColor" />
                                    <span className="text-stone-900 font-bold">{product.rating}</span>
                                    <span className="text-stone-400">({product.reviews} reviews)</span>
                                </div>
                            </div>
                            <p className="text-stone-600 leading-relaxed text-lg">
                                {product.description}
                            </p>
                        </div>

                        <div className="p-6 bg-stone-50 rounded-xl space-y-4 border border-stone-100">
                            <div className="flex justify-between text-sm border-b border-stone-200 pb-2">
                                <span className="text-stone-500">Size</span>
                                <span className="font-bold text-stone-900">{product.size}</span>
                            </div>
                            <div className="flex justify-between text-sm border-b border-stone-200 pb-2">
                                <span className="text-stone-500">Ingredients</span>
                                <span className="font-medium text-stone-900 text-right max-w-[200px]">{product.ingredients}</span>
                            </div>
                            <div className="flex justify-between text-sm">
                                <span className="text-stone-500">Delivery</span>
                                <span className="font-medium text-teal-600">Available in Lagos & Abuja</span>
                            </div>
                        </div>

                        <div className="flex gap-4">
                            <button
                                onClick={() => onAddToCart(product)}
                                className="flex-1 bg-stone-900 text-white py-4 rounded-full font-bold uppercase tracking-widest hover:bg-teal-600 transition-colors shadow-lg"
                            >
                                Add to Cart
                            </button>
                            <button className="w-14 h-14 border border-stone-200 rounded-full flex items-center justify-center text-stone-400 hover:text-red-500 hover:border-red-200 transition-colors">
                                <Heart size={24} />
                            </button>
                        </div>
                    </div>
                </div>

                {/* Reviews Section inside Product Page */}
                <div className="mt-24">
                    <h3 className="text-2xl font-bold mb-8">Customer Reviews</h3>
