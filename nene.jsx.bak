                        <div className="h-64 w-full rounded-2xl mb-6 overflow-hidden relative">
                            <img
                                src={post.image}
                                alt={post.title}
                                className="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                            />
                            <div className="absolute top-4 left-4 bg-white/90 backdrop-blur px-3 py-1 rounded-md text-stone-900 text-xs font-bold uppercase tracking-widest">
                                {post.category}
                            </div>
                        </div>
                        <div className="flex items-center gap-3 text-teal-600 text-xs font-bold uppercase tracking-widest mb-3">
                            <span>{post.date}</span>
                        </div>
                        <h3 className="text-xl font-bold text-stone-900 mb-3 group-hover:text-teal-600 transition-colors font-serif">
                            {post.title}
                        </h3>
                        <p className="text-stone-500 text-sm leading-relaxed mb-4">
                            {post.excerpt}
                        </p>
                        <div className="flex items-center gap-2 text-stone-900 text-sm font-bold group-hover:gap-4 transition-all">
                            Read Article <ArrowRight size={16} className="text-teal-600" />
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>
);

// 8. FAQ Section
const FAQ = () => {
    const [openIndex, setOpenIndex] = useState(null);

    return (
        <section className="py-24 px-6 bg-stone-50">
            <div className="max-w-3xl mx-auto">
                <SectionTitle>Frequently Asked Questions</SectionTitle>
                <div className="space-y-4">
                    {FAQS.map((faq, index) => (
                        <div key={index} className="bg-white rounded-xl p-6 shadow-sm cursor-pointer" onClick={() => setOpenIndex(openIndex === index ? null : index)}>
                            <div className="flex justify-between items-center">
                                <h4 className="font-bold text-stone-900">{faq.q}</h4>
                                {openIndex === index ? <ChevronUp size={20} /> : <ChevronDown size={20} />}
                            </div>
                            {openIndex === index && (
                                <p className="mt-4 text-stone-600 text-sm leading-relaxed animate-fade-in">
                                    {faq.a}
                                </p>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </section>
    );
};

// 9. Checkout Page
const Checkout = ({ cart, total, onBack }) => (
    <div className="pt-24 pb-12 px-6 min-h-screen bg-stone-50">
        <div className="max-w-5xl mx-auto">
            <button onClick={onBack} className="flex items-center text-stone-500 hover:text-stone-900 mb-8">
                <ArrowLeft size={20} className="mr-2" /> Back to Shop
            </button>

            <div className="grid md:grid-cols-3 gap-8">
                <div className="md:col-span-2 space-y-6">
                    <div className="bg-white p-8 rounded-2xl shadow-sm">
                        <h2 className="text-xl font-bold mb-6 flex items-center gap-2">
                            <MapPin className="text-teal-600" /> Shipping Details
                        </h2>
                        <form className="grid grid-cols-2 gap-4">
                            <input placeholder="First Name" className="bg-stone-50 p-3 rounded-lg w-full" />
                            <input placeholder="Last Name" className="bg-stone-50 p-3 rounded-lg w-full" />
                            <input placeholder="Address" className="col-span-2 bg-stone-50 p-3 rounded-lg w-full" />
                            <input placeholder="City" className="bg-stone-50 p-3 rounded-lg w-full" />
                            <select className="bg-stone-50 p-3 rounded-lg w-full">
                                <option>Select State</option>
                                {NIGERIAN_STATES.map(s => <option key={s}>{s}</option>)}
                            </select>
                            <input placeholder="Phone Number" className="col-span-2 bg-stone-50 p-3 rounded-lg w-full" />
                        </form>
                    </div>

                    <div className="bg-white p-8 rounded-2xl shadow-sm">
                        <h2 className="text-xl font-bold mb-6 flex items-center gap-2">
                            <CreditCard className="text-teal-600" /> Payment
                        </h2>
                        <div className="border border-teal-200 bg-teal-50 p-4 rounded-xl flex items-center justify-between cursor-pointer ring-2 ring-teal-500">
                            <div className="flex items-center gap-3">
                                <div className="w-4 h-4 rounded-full bg-teal-600" />
                                <span className="font-bold text-stone-900">Paystack</span>
                            </div>
                            <div className="flex gap-2">
                                <div className="w-8 h-5 bg-stone-300 rounded" /> {/* Visa placeholder */}
                                <div className="w-8 h-5 bg-stone-300 rounded" /> {/* MC placeholder */}
                            </div>
                        </div>
                        <p className="text-xs text-stone-500 mt-4 flex items-center gap-1">
                            <LockIcon size={12} /> Secure payment processing by Paystack
                        </p>
                    </div>
                </div>

                <div className="bg-white p-8 rounded-2xl shadow-sm h-fit">
                    <h3 className="font-bold text-lg mb-4">Order Summary</h3>
                    <div className="space-y-4 mb-6">
                        {cart.map(item => (
                            <div key={item.id} className="flex justify-between text-sm">
                                <span className="text-stone-600">{item.quantity}x {item.name}</span>
                                <span className="font-medium">₦{(item.price * item.quantity).toLocaleString()}</span>
                            </div>
                        ))}
                    </div>
                    <div className="border-t border-stone-100 pt-4 space-y-2">
                        <div className="flex justify-between text-stone-500">
                            <span>Subtotal</span>
                            <span>₦{total.toLocaleString()}</span>
                        </div>
                        <div className="flex justify-between text-stone-500">
                            <span>Shipping</span>
                            <span>₦1,500</span>
                        </div>
                        <div className="flex justify-between text-xl font-bold text-stone-900 pt-2">
                            <span>Total</span>
                            <span>₦{(total + 1500).toLocaleString()}</span>
                        </div>
                    </div>
                    <button className="w-full bg-teal-600 hover:bg-teal-700 text-white py-4 rounded-xl font-bold mt-8 shadow-lg transition-colors">
                        Pay Now ₦{(total + 1500).toLocaleString()}
                    </button>
                </div>
            </div>
        </div>
    </div>
);

const LockIcon = ({ size }) => (
    <svg
        xmlns="http://www.w3.org/2000/svg"
        width={size}
        height={size}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        strokeWidth="2"
        strokeLinecap="round"
        strokeLinejoin="round"
    >
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
);

// 10. Footer
const Footer = ({ onNavigate }) => (
    <footer className="bg-stone-900 text-white pt-20 pb-10 px-6">
        <div className="max-w-7xl mx-auto grid md:grid-cols-4 gap-12 mb-20">
            <div>
                <div className="text-2xl font-bold mb-6">Nené<span className="text-teal-500">.</span></div>
                <p className="text-stone-400 text-sm leading-relaxed mb-6">
                    Simple ingredients. Authentic culture. A taste of the good life in every spoon.
                </p>
                <div className="flex gap-4 text-stone-400">
                    <Instagram size={20} className="hover:text-teal-400 cursor-pointer" />
                    <Twitter size={20} className="hover:text-teal-400 cursor-pointer" />
                    <Facebook size={20} className="hover:text-teal-400 cursor-pointer" />
                </div>
            </div>

            <div>
                <h4 className="font-bold mb-6">Shop</h4>
                <ul className="space-y-4 text-sm text-stone-400">
                    <li className="hover:text-teal-400 cursor-pointer" onClick={() => onNavigate('shop')}>All Products</li>
                    <li className="hover:text-teal-400 cursor-pointer">Bundles</li>
                    <li className="hover:text-teal-400 cursor-pointer">Subscriptions</li>
                </ul>
            </div>

            <div>
                <h4 className="font-bold mb-6">Support</h4>
                <ul className="space-y-4 text-sm text-stone-400">
                    <li className="hover:text-teal-400 cursor-pointer" onClick={() => onNavigate('faq')}>FAQ</li>
                    <li className="hover:text-teal-400 cursor-pointer">Shipping Policy</li>
                    <li className="hover:text-teal-400 cursor-pointer">Contact Us</li>
                </ul>
            </div>

            <div>
                <h4 className="font-bold mb-6">Newsletter</h4>
                <p className="text-stone-400 text-sm mb-4">Get 10% off your first order.</p>
                <div className="flex">
                    <input
                        type="email"
                        placeholder="Email address"
                        className="bg-stone-800 border-none text-white text-sm px-4 py-3 rounded-l-lg focus:ring-1 focus:ring-teal-500 w-full"
                    />
                    <button className="bg-teal-600 text-white px-4 py-3 rounded-r-lg font-bold hover:bg-teal-500">
                        <ArrowRight size={18} />
                    </button>
                </div>
            </div>
        </div>
        <div className="text-center text-stone-600 text-xs border-t border-stone-800 pt-8">
            © 2025 Nené Dairy Co. Lagos, Nigeria. All rights reserved.
        </div>
    </footer>
);

// --- Main App Component ---

const App = () => {
    const [activeTab, setActiveTab] = useState('home');
    const [cartOpen, setCartOpen] = useState(false);
    const [selectedProduct, setSelectedProduct] = useState(null);
    const [cart, setCart] = useState([]);

    // Scroll to top on tab change
    useEffect(() => {
        window.scrollTo(0, 0);
    }, [activeTab, selectedProduct]);

    const handleAddToCart = (product) => {
        setCart(prev => {
            const existing = prev.find(item => item.id === product.id);
            if (existing) {
                return prev.map(item =>
                    item.id === product.id ? { ...item, quantity: item.quantity + 1 } : item
                );
            }
            return [...prev, { ...product, quantity: 1 }];
        });
        setCartOpen(true);
    };

    const updateQuantity = (id, delta) => {
        setCart(prev => prev.map(item => {
            if (item.id === id) {
                const newQty = item.quantity + delta;
                return newQty > 0 ? { ...item, quantity: newQty } : item;
            }
            return item;
        }));
    };

    const removeFromCart = (id) => {
        setCart(prev => prev.filter(item => item.id !== id));
    };

    // Navigation Handler
    const handleNavigate = (tab) => {
        setActiveTab(tab);
        setSelectedProduct(null);
    };

    const handleProductClick = (product) => {
        setSelectedProduct(product);
        setActiveTab('product-detail');
    };

    const renderContent = () => {
        if (activeTab === 'checkout') {
            return <Checkout cart={cart} total={cart.reduce((acc, item) => acc + item.price * item.quantity, 0)} onBack={() => setActiveTab('shop')} />;
        }

        if (selectedProduct) {
            return <ProductDetail product={selectedProduct} onAddToCart={handleAddToCart} onBack={() => handleNavigate('shop')} />;
        }

        switch (activeTab) {
            case 'home':
                return (
                    <>
                        <Hero onShopNow={() => handleNavigate('shop')} />
                        <Testimonials />
                        <Shop onProductClick={handleProductClick} onAddToCart={handleAddToCart} />
                        <Gallery />
                        <DeliveryInfo />
                        <FAQ />
                        <Blog />
                    </>
                );
            case 'shop':
                return (
                    <div className="pt-20">
                        <Shop onProductClick={handleProductClick} onAddToCart={handleAddToCart} />
                    </div>
                );
            case 'blog':
                return <div className="pt-20"><Blog /></div>;
            case 'faq':
                return <div className="pt-20"><FAQ /></div>;
            case 'reviews':
                return (
                    <div className="pt-32 pb-20 px-6 max-w-4xl mx-auto">
                        <SectionTitle subtitle="See what our community is saying">Reviews</SectionTitle>
                        <div className="grid md:grid-cols-2 gap-6">
                            {REVIEWS.map(review => (
                                <div key={review.id} className="bg-stone-50 p-8 rounded-xl border border-stone-100">
                                    <div className="flex gap-1 text-amber-400 mb-4">
                                        {[...Array(review.rating)].map((_, i) => <Star key={i} size={16} fill="currentColor" />)}
                                    </div>
                                    <p className="text-stone-700 mb-6 text-lg italic">"{review.text}"</p>
                                    <p className="font-bold text-stone-900 uppercase tracking-widest text-sm">- {review.user}</p>
                                </div>
                            ))}
                        </div>
                    </div>
                );
            default:
                return <Hero onShopNow={() => handleNavigate('shop')} />;
        }
    };

    return (
        <div className="min-h-screen bg-[#fafaf9] font-sans text-stone-900 selection:bg-teal-200 selection:text-teal-900">
            <Navbar
                cartCount={cart.reduce((acc, item) => acc + item.quantity, 0)}
                onOpenCart={() => setCartOpen(true)}
                activeTab={activeTab}
                onNavigate={handleNavigate}
            />

            {/* Cart Drawer */}
            <div className={`fixed inset-0 bg-stone-900/40 backdrop-blur-sm z-[60] transition-opacity duration-300 ${cartOpen ? 'opacity-100 pointer-events-auto' : 'opacity-0 pointer-events-none'}`} onClick={() => setCartOpen(false)} />

            <div className={`fixed top-0 right-0 h-full w-full md:w-[450px] bg-white z-[70] transform transition-transform duration-300 shadow-2xl flex flex-col ${cartOpen ? 'translate-x-0' : 'translate-x-full'}`}>
                <div className="p-8 border-b border-stone-100 flex justify-between items-center bg-stone-50">
                    <h2 className="text-2xl font-bold font-serif">Your Order</h2>
                    <button onClick={() => setCartOpen(false)} className="text-stone-400 hover:text-stone-900"><X size={24} /></button>
                </div>

                <div className="flex-1 overflow-y-auto p-8 space-y-6">
                    {cart.length === 0 ? (
                        <div className="text-center py-20">
                            <ShoppingBag size={48} className="mx-auto text-stone-200 mb-4" />
                            <p className="text-stone-500">Your bag is empty.</p>
                        </div>
                    ) : (
                        cart.map(item => (
                            <div key={item.id} className="flex gap-4 bg-stone-50 p-4 rounded-xl border border-stone-100">
                                <div className="w-20 h-20 flex items-center justify-center shrink-0 bg-white rounded-lg p-2">
                                    <ProductImage type={item.name} className="w-full h-full" />
                                </div>
                                <div className="flex-1">
                                    <div className="flex justify-between mb-1">
                                        <h4 className="font-bold text-stone-900">{item.name}</h4>
                                        <span className="font-medium text-teal-600">₦{(item.price * item.quantity).toLocaleString()}</span>
                                    </div>
                                    <div className="flex justify-between items-center mt-4">
                                        <div className="flex items-center gap-3 bg-white rounded-full px-3 py-1 border border-stone-200">
                                            <button onClick={() => updateQuantity(item.id, -1)}><Minus size={14} /></button>
                                            <span className="text-sm font-bold w-4 text-center">{item.quantity}</span>
                                            <button onClick={() => updateQuantity(item.id, 1)}><Plus size={14} /></button>
                                        </div>
                                        <button onClick={() => removeFromCart(item.id)} className="text-stone-400 hover:text-red-500"><Trash2 size={18} /></button>
                                    </div>
                                </div>
                            </div>
                        ))
                    )}
                </div>

                {cart.length > 0 && (
                    <div className="p-8 border-t border-stone-100 bg-stone-50">
                        <div className="flex justify-between mb-4 text-xl font-bold">
                            <span>Total</span>
                            <span>₦{cart.reduce((acc, item) => acc + item.price * item.quantity, 0).toLocaleString()}</span>
                        </div>
                        <button
                            onClick={() => { setCartOpen(false); setActiveTab('checkout'); }}
                            className="w-full bg-stone-900 hover:bg-teal-600 text-white py-4 rounded-full font-bold uppercase tracking-widest transition-all"
                        >
                            Checkout
                        </button>
                    </div>
                )}
            </div>

            <main>
                {renderContent()}
            </main>

            <Footer onNavigate={handleNavigate} />
        </div>
    );
};

export default App;