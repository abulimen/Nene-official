// 4. Product Details Page
const ProductDetail = ({ product, onAddToCart, onBack }) => {
    if (!product) return null;

    return (
        <div className="pt-24 pb-12 px-6 min-h-screen bg-white">
            <div className="max-w-6xl mx-auto">
                <button onClick={onBack} className="flex items-center text-stone-500 hover:text-stone-900 mb-8">
                    <ArrowLeft size={20} className="mr-2" /> Back to Shop
                </button>

                <div className="grid md:grid-cols-2 gap-16 items-center">
                    <div className="bg-stone-50 rounded-[3rem] p-12 flex items-center justify-center relative">
                        <ProductImage type={product.name} className="w-full max-w-md drop-shadow-2xl animate-float" />
