                                <div className="flex gap-1 text-amber-400 mb-2">
                                    {[...Array(review.rating)].map((_, i) => <Star key={i} size={14} fill="currentColor" />)}
                                </div>
                                <p className="text-stone-700 mb-4 italic">"{review.text}"</p>
